{
  "name": "maplibre-gl-interpolate-heatmap",
  "version": "0.1.6",
  "private": false,
  "description": "Mapbox layer for average/interpolation heatmaps",
  "keywords": [
    "average",
    "heatmap",
    "interpolation",
    "layer",
    "map",
    "mapbox",
    "maplibre",
    "temperature"
  ],
  "homepage": "https://maplibre-gl-interpolate-heatmap.geoql.in",
  "bugs": {
    "url": "https://github.com/geoql/maplibre-gl-interpolate-heatmap/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "contributors": [
    "Léo Leplat",
    "Chris Santamaria"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/maplibre-gl-interpolate-heatmap.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test run",
    "prepare": "is-ci || husky",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "typecheck": "vp check --no-fmt --no-lint",
    "publish:npm": "npm publish --access public",
    "publish:jsr": "pnpm dlx jsr publish",
    "build:demo": "pnpm run build && pnpm --filter maplibre-gl-interpolate-heatmap-demo run build",
    "typecheck:demo": "pnpm run build && pnpm --filter maplibre-gl-interpolate-heatmap-demo run typecheck",
    "deploy": "pnpm run build && pnpm --filter maplibre-gl-interpolate-heatmap-demo run deploy"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/earcut": "^3.2.4",
    "@types/node": "^26.6.5",
    "earcut": "^3.2.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "maplibre-gl": "^6.15.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "maplibre-gl": ">=3.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}

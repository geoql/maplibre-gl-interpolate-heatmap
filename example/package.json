{
  "name": "maplibre-gl-interpolate-heatmap-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Live demo of maplibre-gl-interpolate-heatmap on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler dev --config .output/server/wrangler.json",
    "deploy": "nuxt build && wrangler deploy --config .output/server/wrangler.json",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.1.0",
    "maplibre-gl": "^6.16.0",
    "maplibre-gl-interpolate-heatmap": "workspace:*",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.0"
  }
}
